# /etc/retail-store/cart.env (installed root:retail 640)
PORT=8082
RETAIL_CART_PERSISTENCE_PROVIDER=dynamodb
RETAIL_CART_PERSISTENCE_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
RETAIL_CART_PERSISTENCE_DYNAMODB_TABLE_NAME=Items

# false = keep the data. true makes Cart DELETE and re-create the table at every start
# (DynamoDBCartService.init()). Task 4 Step C6 creates the table once on a fresh server.

RETAIL_CART_PERSISTENCE_DYNAMODB_CREATE_TABLE=false

# DynamoDB Local accepts any credentials, but the AWS SDK insists on having some
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
JAVA_OPTS=-Xmx320m
