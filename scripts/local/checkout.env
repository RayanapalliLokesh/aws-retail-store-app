# /etc/retail-store/checkout.env (installed root:retail 640)

PORT=8085
NODE_ENV=production
RETAIL_CHECKOUT_PERSISTENCE_PROVIDER=redis
RETAIL_CHECKOUT_PERSISTENCE_REDIS_URL=redis://127.0.0.1:6379

# Orders runs natively (empty = Checkout uses its built-in mock Orders client)
RETAIL_CHECKOUT_ENDPOINTS_ORDERS=http://127.0.0.1:8083
